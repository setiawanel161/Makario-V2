# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo

# Environment & Secrets (Keep .env.example tracked)
.env
.env*.local
.env.development
.env.production
.env.test
*.pem

# Prisma & Local Database Files
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/migration_lock.toml~

# Testing & QA Artifacts (Vitest / Playwright)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs & Runtime Data
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vercel

# OS & Editor Files (Keep .clinerules & AGENTS.md tracked)
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
